<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>org.testcompass.plugin</id>
    <name>TestCompass</name>
    <vendor>littlehousezh</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.coverage</depends>
    <depends>com.intellij.modules.java</depends>

    <actions>
        <action id="AnalyzeCoverageAction"
                class="org.testcompass.plugin.actions.AnalyzeCoverageAction"
                text="TestCompass"
                description="Rank methods that need tests using the current IDE coverage suite.">
            <!-- Puts it under Tools menu -->
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>

    <resource-bundle>messages.MyBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity
                implementation="org.testcompass.plugin.startup.CoverageAutoAnalysisActivity"/>

        <applicationConfigurable
                id="testcompass.settings"
                displayName="TestCompass"
                instance="org.testcompass.plugin.coverage.CoverageSettingsConfigurable"/>

        <toolWindow
                id="TestCompass"
                anchor="right"
                factoryClass="org.testcompass.plugin.coverage.CoverageHotspotsToolWindowFactory"
                canCloseContents="false"/>
    </extensions>


</idea-plugin>
